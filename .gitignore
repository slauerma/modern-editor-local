# Publish only the source tree and the documents listed here.
/*
!/.gitignore
!/README.md
!/TESTING.md
!/PRIVACY.md
!/SECURITY.md
!/CONTRIBUTING.md
!/CHANGELOG.md
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/ci.yml
!/docs/
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/THIRD_PARTY_LICENSES.txt
!/licenses/
!/package.json
!/package-lock.json
!/tsconfig.json
!/src/
!/tests/
!/scripts/
/scripts/*
!/scripts/build.mjs
!/scripts/copy-build-assets.mjs
!/scripts/copy-build-assets.d.mts
!/scripts/generate-compile-fixtures.mjs
!/scripts/check-discussion-proposals.mjs
!/scripts/check-codex-isolation.mjs
!/scripts/check-help-chat.mjs
!/scripts/check-chat-images-protocol.mjs
!/scripts/collect-third-party-notices.mjs
!/fixtures/
!/resources/
!/demo/
/demo/*
!/demo/README.md

# Local state must remain private even if created inside a source subtree.
**/node_modules/
**/.modern-editor/
**/.runtime/
**/.test-runs/
**/test-evidence/
**/.env
**/.env.*
**/.npmrc
**/.pypirc
**/.netrc
**/auth.json
**/credentials.json
**/id_rsa
**/id_ed25519
*.pem
*.key
*.p12
*.pfx
**/.DS_Store
*.log

# Editor settings, caches and generated output within allowed source folders.
**/.vscode/
**/.idea/
**/.codex/
**/.agents/
**/.cache/
**/.npm/
**/dist/
**/coverage/
**/playwright-report/
**/test-results/
*~
*.swp
*.swo
*.bak
*.orig
*.pending

# TeX compiler output; the editable .tex and .bib sources remain allowed.
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.out
*.run.xml
*.synctex
*.synctex.gz
*.toc
*.xdv

# Compile fixtures are generated from text source; no binary media is tracked.
*.pdf
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.bmp
*.tif
*.tiff
*.ico
*.icns
*.mp4
*.mov
*.webm
*.mp3
*.wav
*.m4a
*.zip
*.tar
*.gz
*.otf
*.ttf
*.woff
*.woff2

# Explicitly requested, reviewed general walkthrough only.
!/demo/modern-editor-demo.mp4
